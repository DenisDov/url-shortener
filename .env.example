# ==========================================
# Application Config
# ==========================================
APP_ENV=development
SERVICE_NAME=url-shortener
# Port the Go server binds to. Inside docker compose this is always 8080;
# publish it on a different host port with API_PORT below.
HTTP_PORT=8080
# Host port that docker compose publishes the api on.
API_PORT=8080
# Public origin used to build the returned short links.
BASE_URL=http://localhost:8080

# ==========================================
# Postgres
# ==========================================
# Consumed by docker compose: these configure the db service AND are assembled
# into the DATABASE_URL handed to the api container.
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=urlshortener

# Host port compose publishes Postgres on. Not 5432, because other projects on
# this machine already bind it -- the container still listens on 5432 inside
# the compose network, so only the host-side mapping changes.
DB_PORT=5433

# Connection string for running OUTSIDE compose -- `make run`, `make dev`, and
# `make migrate-up` all read this. Points at DB_PORT above, so it works against
# the containerised db.
DB_DSN=postgres://urlshortener:change_me_locally@localhost:5433/urlshortener?sslmode=disable

# ==========================================
# Redis
# ==========================================
# Host port compose publishes Redis on.
REDIS_PORT=6379
# Local default. Inside compose this is overridden with redis:6379.
REDIS_ADDR=localhost:6379
REDIS_DB=0
# Leave both unset for local/compose Redis. Hosted providers (e.g. Upstash)
# require a password and TLS on the same port -- set REDIS_PASSWORD and
# REDIS_TLS=true for those.
REDIS_PASSWORD=
REDIS_TLS=false

# ==========================================
# URL Shortener Config
# ==========================================
CACHE_TTL=1h
CODE_LENGTH=7

# ==========================================
# HTTP Server Timeouts
# ==========================================
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
# Keep-alive idle window. Must exceed the idle timeout of any proxy in front of
# the service, otherwise the proxy can reuse a connection as the server closes
# it and you get intermittent 502s.
IDLE_TIMEOUT=120s
